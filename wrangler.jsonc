{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "codex-split",
    "main": "./worker/index.ts",
    "compatibility_date": "2026-08-29",
    "workers_dev": false,
    "preview_urls": false,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "codex-split",
            "database_id": "b9ed884b-3312-479d-859a-b8dd983a7787",
            "migrations_dir": "migrations",
        },
    ],
    "vars": {
        "TRACKER_WARNING_PERCENT": "90",
        "RETENTION_DAYS": "30",
        "QUOTA_WEIGHT_PER_PERCENT": "13200000",
        "SYNC_INTERVAL_SECONDS": "60",
        "IDLE_INTERVAL_SECONDS": "60",
    },
    "triggers": {
        "crons": ["17 3 * * *"],
    },
    "observability": {
        "enabled": true,
    },
}
